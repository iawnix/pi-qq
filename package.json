{
  "name": "pi-qq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QQ private and group chat adapter for Pi",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-qq": "dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "~1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "undici": "8.12.2"
  }
}
