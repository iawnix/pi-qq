{
  "name": "pi-qq",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "QQ chat, scoped memory and images for Pi",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-qq": "dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "ipaddr.js": "2.5.0",
    "proper-lockfile": "4.1.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "~1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iawnix/pi-qq.git"
  },
  "homepage": "https://github.com/iawnix/pi-qq#readme",
  "bugs": {
    "url": "https://github.com/iawnix/pi-qq/issues"
  },
  "files": [
    "src/",
    "dist/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "qqbot.example.json",
    "examples/",
    "start-friend.sh"
  ]
}
